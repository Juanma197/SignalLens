# Backend
SIGNALLENS_ENVIRONMENT=development
SIGNALLENS_API_HOST=127.0.0.1
SIGNALLENS_API_PORT=8000
SIGNALLENS_ALLOWED_ORIGINS=http://localhost:3000
SIGNALLENS_DATABASE_PATH=data/signallens.duckdb
# Production Railway volume mount. The database must resolve beneath this path.
SIGNALLENS_PERSISTENT_VOLUME_PATH=
# File or directory containing DuckDB backups; production preflight requires it.
SIGNALLENS_BACKUP_PATH=
SIGNALLENS_BACKUP_MAX_AGE_HOURS=48
# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure the same server-side secret for the API and Next.js deployment.
SIGNALLENS_API_TOKEN=
# Required for SEC EDGAR requests; use a real monitored contact address.
SIGNALLENS_SEC_USER_AGENT=SignalLens research your-email@example.com
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
SIGNALLENS_FRED_API_KEY=your-fred-api-key
# Optional free-tier credential used only by the mutation-free research probe.
SIGNALLENS_EODHD_API_TOKEN=
# Separate deliberate write authorizations; never expose these as NEXT_PUBLIC values.
SIGNALLENS_REFRESH_AUTHORIZATION_TOKEN=
SIGNALLENS_SHADOW_AUTHORIZATION_TOKEN=
# Offline scheduling abstraction remains disabled unless an embedding service opts in.
SIGNALLENS_SCHEDULER_ENABLED=false
# Set only on the single Railway worker designated to schedule. Staging overrides this.
SIGNALLENS_SCHEDULER_INSTANCE_ID=
SIGNALLENS_STAGING_MODE=false
SIGNALLENS_BACKUP_RETENTION_COUNT=3

# Frontend (copied into frontend/.env.local by scripts/start.ps1)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Production frontend: use the backend's private or public Railway URL.
SIGNALLENS_API_URL=
# Configure these only in the deployed frontend service.
SIGNALLENS_DASHBOARD_USERNAME=
SIGNALLENS_DASHBOARD_PASSWORD=
# Never expose tokens or passwords through NEXT_PUBLIC_ variables.
# Separate database used exclusively by global research evaluation.
SIGNALLENS_RESEARCH_DATABASE_PATH=data/research/signallens-research.duckdb
# Separate store for the unvalidated prototype (watchlist, notes, snapshots).
SIGNALLENS_PROTOTYPE_DATABASE_PATH=data/prototype/signallens-prototype.duckdb
# Allows writes to that store only (also in staging mode). Leave false unless needed.
SIGNALLENS_PROTOTYPE_WRITES_ENABLED=false

# Railway staging backend (safe examples; set on the backend service only)
# SIGNALLENS_ENVIRONMENT=staging
# SIGNALLENS_STAGING_MODE=true
# SIGNALLENS_PERSISTENT_VOLUME_PATH=/data
# SIGNALLENS_RESEARCH_DATABASE_PATH=/data/research/signallens-research.duckdb
# SIGNALLENS_DATABASE_PATH=/data/production/signallens-production.duckdb
# SIGNALLENS_BACKUP_PATH=/data/backups
# SIGNALLENS_ALLOWED_ORIGINS=https://signal-lens-staging.example.up.railway.app
# SIGNALLENS_SCHEDULER_ENABLED=false
# TZ=UTC
# Frontend service only: SIGNALLENS_API_URL=https://backend.example.up.railway.app
